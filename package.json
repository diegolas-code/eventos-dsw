{
  "name": "eventos-dsw",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write .",
    "prepare": "husky install",
    "typecheck": "tsc --noEmit || true"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ],
    "*.{json,md}": [
      "prettier --write",
      "git add"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^17.0.5",
    "micromatch": "^4.0.8",
    "minimatch": "^10.2.5",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "yaml": "^2.9.0"
  }
}
