# .env.example
#
# Por qué usar un archivo .env:
# - Documentar las variables de entorno necesarias (URLs, claves, credenciales de servicios externos, configuración de base de datos, etc.).
# - Servir como plantilla segura: nunca debe contener valores reales ni secretos.
# - Facilitar que desarrolladores y despliegues sepan qué variables crear.
#
# Instrucciones rápidas:
# 1) Copia este archivo a `.env`.
# 2) Rellena los valores con las credenciales y configuraciones reales.
# 3) Nunca subas `.env` al control de versiones; el repositorio debe incluir únicamente `.env.example`.
#
# Ejemplo de variables (reemplace los valores de ejemplo):
# DATABASE_URL=postgres://usuario:contraseña@localhost:5432/mi_base_de_datos
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service-role-key-aqui
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=nombre_del_bucket
# R2_ACCESS_KEY=access_key_ejemplo
# R2_SECRET_KEY=secret_key_ejemplo
# NEXT_PUBLIC_API_URL=https://api.midominio.com

# --- BASE DE DATOS (Prisma/Supabase) ---
# Se obtiene en Supabase > Settings > Database > Connection string (Modo Direct o Transaction)
DATABASE_URL="postgres://postgres:[TU_CONTRASEÑA]@db.ztoxbbvmagofdjntlnte.supabase.co:5432/postgres"

# --- SUPABASE AUTH & API ---
# Se obtienen en Supabase > Settings > API
SUPABASE_URL="https://[TU_PROYECTO_ID].supabase.co"
SUPABASE_ANON_KEY="[TU_ANON_KEY_PUBLICA]"
# ¡CUIDADO! Esta clave solo se usa en el Backend para tareas administrativas
SUPABASE_SERVICE_ROLE_KEY="[TU_SERVICE_ROLE_KEY_SECRETA]"

# --- ALMACENAMIENTO (Cloudflare R2) ---
# Se obtienen en Cloudflare > R2 > [Tu Bucket] > Settings
R2_ENDPOINT="https://[TU_ACCOUNT_ID].r2.cloudflarestorage.com"
R2_BUCKET="[NOMBRE_DE_TU_BUCKET]"
R2_ACCESS_KEY="[TU_ACCESS_KEY_ID]"
R2_SECRET_KEY="[TU_SECRET_ACCESS_KEY]"

# --- CONFIGURACIÓN DE ENTORNO ---
NODE_ENV="development"
PORT=3000
